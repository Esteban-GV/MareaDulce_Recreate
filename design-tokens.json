    "sm": { "value": "0 1px 2px rgba(36, 91, 89, 0.06)" },
    "md": { "value": "0 4px 12px rgba(36, 91, 89, 0.08)" },
    "lg": { "value": "0 12px 32px rgba(36, 91, 89, 0.10)" }
