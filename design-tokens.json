        "600": { "value": "#4BBBAA", "type": "color", "description": "Hover botón primario" },
        "700": { "value": "#47B5A5", "type": "color", "description": "Pressed botón primario" }
      },
      "petroleo": {
        "500": { "value": "#245B59", "type": "color", "description": "Verde petróleo para títulos, navegación y acentos" }
      },
      "menta": {
        "100": { "value": "#F4F8F6", "type": "color", "description": "Fondo suave modo Admin" },
        "500": { "value": "#E1F3ED", "type": "color", "description": "Menta suave para fondos y superficies" }
      },
      "crema": {
        "100": { "value": "#FFF9F0", "type": "color", "description": "Blanco crema fondo principal de tienda" },
