      "priceL": { "fontSize": "28px", "lineHeight": "32px", "fontWeight": "700", "fontVariantNumeric": "tabular-nums", "fontFamily": "{typography.fontFamily.interface}" },
      "button": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": "600", "fontFamily": "{typography.fontFamily.interface}" }
    }
